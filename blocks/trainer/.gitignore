# Runtime data (large files, generated per-run)
artifacts/archives/
artifacts/data/im_data/
artifacts/data/lf_data/
artifacts/data/raw/
# Exact Hugging Face files downloaded by scripts/train.sh
artifacts/data/hf_data/
# Staged smoke dataset snapshot (88 MB; produced by tests/smoke/prepare_smoke_data.sh,
# canonical copy lives in $SHARED_RUNTIME/sft and is symlinked in for CI)
artifacts/data/examples/

# Disposable smoke training config (written per-run by tests/smoke/10_train_demo.sh)
tests/smoke/.config.smoke.*.yaml
tests/smoke/.config.smoke.*.yaml.lock

# Transient fcntl lock sidecars written next to config.yaml / dataset_info.json
config.yaml.lock

# Model checkpoints
artifacts/model/

# WandB run data
artifacts/wandb/

# Training logs
artifacts/logs/

# Generated training YAML (regenerated from config.yaml each run)
artifacts/training_config/*.yaml

# Downloaded wheels (large binaries; reinstalled by scripts/install_env.sh)
artifacts/wheels/

# Local Claude Code settings (machine-specific, never commit)
.claude/settings.local.json

# Docs site build outputs (also covered by docs/.gitignore)
docs/node_modules/
docs/.next/
docs/.source/
docs/out/

# Python
__pycache__/
*.pyc

# uv environment built by scripts/install_env.sh (large, rebuildable)
artifacts/env
# Symlinked smoke dataset (the dir-form rule above misses the symlink)
artifacts/data/examples
# Editor/sync backup artifacts (e.g. .efc_<hashes>_<name>)
.efc_*

# Claude Code local state (machine-specific, never commit)
.claude/settings.local.json

# Secrets
*token*.txt
*token*.json
*.token
*.pem
*.key

# Environment variables
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Extra untracked checkouts under subblock repos/ (submodules are tracked via .gitmodules)
subblock/*/repos/*
!subblock/*/repos/.gitkeep

# Node
node_modules/
npm-debug.log*
yarn-error.log*
docs/out/
docs/.next/
docs/.source/

# OS artifacts
.DS_Store
Thumbs.db

# Model artifacts and large data files
*.ckpt
*.pt
*.bin
*.safetensors
artifacts/files/

# Runtime run index — written by archive_run.sh, not committed
artifacts/index.yaml
subblock/*/artifacts/index.yaml

# SWE-gen subblock — generated data and virtual env
subblock/curator/artifacts/*
subblock/curator/scripts/jobs/*
subblock/curator/scripts/.swegen-*/

# Tracer subblock — runtime mount + per-run artifacts (kept manifest yamls tracked)
subblock/tracer/artifacts/*

# Dashboard transient runtime output
subblock/curator/dashboard/memory/.progress_monitor_all_state.jsonl.*
subblock/curator/dashboard/dashboard_sync.log

# Local harbor venv + root-level run outputs (machine-specific, never committed)
.venv-harbor/
artifacts/prod-run/
artifacts/root-smoke-monitor/

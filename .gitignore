# Claude Code local state (machine-specific, never commit)
.claude/settings.local.json

# Secrets
*token*.txt
*token*.json
*.token
*.pem
*.key

# Environment variables
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Extra untracked checkouts under subblock repos/ (submodules are tracked via .gitmodules)
subblock/*/repos/*
!subblock/*/repos/.gitkeep

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# OS artifacts
.DS_Store
Thumbs.db

# Model artifacts and large data files
*.ckpt
*.pt
*.bin
*.safetensors
artifacts/files/

# SWE-gen subblock — generated data and virtual env
subblock/swegen/artifacts/*
subblock/swegen/scripts/jobs/*
subblock/swegen/scripts/.swegen-*/

# Trajgen subblock — runtime mount + per-run artifacts (kept manifest yamls tracked)
subblock/trajgen/artifacts/*
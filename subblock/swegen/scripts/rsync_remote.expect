#!/usr/bin/expect -f
set timeout 300
set pass [lindex $argv 0]
set src [lindex $argv 1]
set dst [lindex $argv 2]

spawn rsync -avz --exclude=".swegen" --exclude="swegen-env2" --exclude="__pycache__" --exclude="*.pyc" --exclude=".git" $src $dst
expect {
    "password:" { send "$pass\r"; exp_continue }
    eof
}

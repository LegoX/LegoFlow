# Harbor submodule working tree contents (the gitlink itself is tracked).
# Ignore everything inside repos/harbor/ so local checkouts don't pollute status.
repos/harbor/

# Runtime artifacts generated by Harbor evaluation runs.
artifacts/jobs/
artifacts/litellm/
artifacts/logs/
artifacts/env/
artifacts/runtime/

# Local Claude Code settings (not shared).
.claude/settings.local.json

# Local environment and caches.
.env
.env.*
!.env.example
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
*.log
.DS_Store

# Editor/sync backup artifacts (e.g. .efc_<hashes>_<name>).
.efc_*
